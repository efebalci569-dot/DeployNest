<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Version>0.2.0</Version>
    <Product>DeployNest</Product>
    <Company>DeployNest contributors</Company>
    <Authors>DeployNest contributors</Authors>
    <Copyright>Copyright © 2026 DeployNest contributors</Copyright>
    <RepositoryUrl>https://github.com/efebalci569-dot/DeployNest</RepositoryUrl>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep symbols inside the binaries so a published single-file build is just one EXE. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
