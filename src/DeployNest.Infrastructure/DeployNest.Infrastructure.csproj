<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cross-platform: shared by the Windows (WPF) and Linux (Avalonia) apps. Windows-only
         classes are marked [SupportedOSPlatform("windows")]. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeployNest.Infrastructure</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeployNest.Core\DeployNest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default catalog ships inside the EXE so single-file builds never miss it. -->
    <EmbeddedResource Include="..\..\catalog\software.json" LogicalName="DeployNest.Catalog.software.json" Link="Catalog\software.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeployNest.Tests" />
  </ItemGroup>

</Project>
