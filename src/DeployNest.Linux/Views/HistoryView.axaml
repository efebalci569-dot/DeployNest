<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeployNest.Linux.ViewModels"
             xmlns:c="using:DeployNest.Linux.Controls"
             xmlns:l="using:DeployNest.Linux.Services"
             x:Class="DeployNest.Linux.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="32,28,32,24">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="4">
                <TextBlock Text="{l:Loc History.Title}" Classes="h1" />
                <TextBlock Text="{Binding Summary}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding AskClearCommand}" IsVisible="{Binding !IsEmpty}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                    <TextBlock Text="{l:Loc History.Clear}" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Classes="banner" Margin="0,0,0,12" IsVisible="{Binding ConfirmClear}">
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Loc History.Clear.Title}" Classes="h3" />
                <TextBlock Text="{l:Loc History.Clear.Message}" Classes="body" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Command="{Binding ClearCommand}" Content="{l:Loc History.Clear.Confirm}" />
                    <Button Command="{Binding CancelClearCommand}" Content="{l:Loc Common.Cancel}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
            <PathIcon Data="{StaticResource Icon.History}" Width="40" Height="40" Foreground="{DynamicResource Dn.Text3}" />
            <TextBlock Text="{l:Loc History.Empty}" Classes="h2" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Loc History.Empty.Body}" Classes="body" TextAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HistoryRow">
                        <Border Classes="card" Padding="14,10" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,160,140,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Program}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}" Classes="caption" IsVisible="{Binding HasMessage}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Date}" Classes="caption" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MethodText}" Classes="caption" VerticalAlignment="Center" />
                                <Border Grid.Column="3" Classes="pill"
                                        Classes.success="{Binding Pill, Converter={x:Static c:Converters.EnumIs}, ConverterParameter=Success}"
                                        Classes.warning="{Binding Pill, Converter={x:Static c:Converters.EnumIs}, ConverterParameter=Warning}"
                                        Classes.danger="{Binding Pill, Converter={x:Static c:Converters.EnumIs}, ConverterParameter=Danger}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
