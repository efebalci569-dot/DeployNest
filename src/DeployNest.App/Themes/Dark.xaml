<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: dark theme. Light.xaml defines the same keys. -->
    <SolidColorBrush x:Key="Dn.WindowBackground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Dn.LayerBackground" Color="#232323" />
    <SolidColorBrush x:Key="Dn.LayerBorder" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Dn.CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Dn.CardBackgroundHover" Color="#313131" />
    <SolidColorBrush x:Key="Dn.CardBorder" Color="#363636" />
    <SolidColorBrush x:Key="Dn.CardBorderHover" Color="#454545" />
    <SolidColorBrush x:Key="Dn.Divider" Color="#353535" />

    <SolidColorBrush x:Key="Dn.TextPrimary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Dn.TextSecondary" Color="#C2C2C2" />
    <SolidColorBrush x:Key="Dn.TextTertiary" Color="#8F8F8F" />
    <SolidColorBrush x:Key="Dn.TextOnAccent" Color="#06213D" />

    <Color x:Key="Dn.AccentColor">#5CB6FF</Color>
    <SolidColorBrush x:Key="Dn.Accent" Color="#5CB6FF" />
    <SolidColorBrush x:Key="Dn.AccentHover" Color="#74C1FF" />
    <SolidColorBrush x:Key="Dn.AccentPressed" Color="#4AA3EC" />
    <SolidColorBrush x:Key="Dn.AccentSubtle" Color="#1B3247" />
    <SolidColorBrush x:Key="Dn.AccentText" Color="#7CC4FF" />

    <SolidColorBrush x:Key="Dn.SubtleHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Dn.SubtlePressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="Dn.NavSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Dn.ControlBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Dn.ControlBorder" Color="#424242" />
    <SolidColorBrush x:Key="Dn.ControlDisabledBackground" Color="#262626" />
    <SolidColorBrush x:Key="Dn.ControlDisabledText" Color="#6E6E6E" />

    <SolidColorBrush x:Key="Dn.SuccessText" Color="#7BD88A" />
    <SolidColorBrush x:Key="Dn.SuccessBackground" Color="#1E3523" />
    <SolidColorBrush x:Key="Dn.WarningText" Color="#F5C451" />
    <SolidColorBrush x:Key="Dn.WarningBackground" Color="#3B3018" />
    <SolidColorBrush x:Key="Dn.DangerText" Color="#FF9C9C" />
    <SolidColorBrush x:Key="Dn.DangerBackground" Color="#442526" />
    <SolidColorBrush x:Key="Dn.NeutralBackground" Color="#353535" />
    <SolidColorBrush x:Key="Dn.DangerSolid" Color="#D9483B" />
    <SolidColorBrush x:Key="Dn.LogoTile" Color="#EFEFEF" />
    <SolidColorBrush x:Key="Dn.LogoTileBorder" Color="#00000000" />

    <SolidColorBrush x:Key="Dn.Scrim" Color="#99000000" />
    <Color x:Key="Dn.ShadowColor">#000000</Color>
    <LinearGradientBrush x:Key="Dn.HeroBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1D2B40" />
        <GradientStop Offset="1" Color="#16313A" />
    </LinearGradientBrush>
</ResourceDictionary>
