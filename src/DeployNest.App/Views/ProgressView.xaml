<UserControl x:Class="DeployNest.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:DeployNest.App.Localization"
             xmlns:c="clr-namespace:DeployNest.App.Controls"
             xmlns:vm="clr-namespace:DeployNest.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProgressViewModel}">
    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{l:Loc Progress.Title}" Style="{StaticResource Dn.PageHeader}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dn.Text.Secondary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Dn.Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Style="{StaticResource Dn.Button}" Command="{Binding CancelCommand}"
                        Visibility="{Binding Session.IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Dn.DangerText}" />
                        <TextBlock Text="{l:Loc Progress.Cancel}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button.Primary}" Content="{l:Loc Progress.ViewResults}" Command="{Binding ViewResultsCommand}"
                        Visibility="{Binding Session.LastResult, Converter={StaticResource HasValueToVisibility}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Dn.Card}" Margin="0,18,0,14" Padding="20,16">
            <StackPanel>
                <ProgressBar Style="{StaticResource Dn.Progress}" Height="6" Value="{Binding OverallPercent, Mode=OneWay}" />
                <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Dn.Text.Body}" Margin="0,12,0,0"
                           Visibility="{Binding CurrentText, Converter={StaticResource HasValueToVisibility}}" />
                <TextBlock Text="{l:Loc Progress.UacHint}" Style="{StaticResource Dn.Text.Caption}" Margin="0,6,0,0"
                           Visibility="{Binding Session.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Session.Items}" ItemContainerStyle="{StaticResource Dn.PlainItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,24">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProgressItemViewModel}">
                    <Border Style="{StaticResource Dn.Card}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:AppIcon Width="36" Monogram="{Binding Software.Monogram}" AccentColor="{Binding Software.AccentColor}" Source="{Binding Software.Icon}" />
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Software.Name}" Style="{StaticResource Dn.Text.BodyStrong}" />
                                <TextBlock Style="{StaticResource Dn.Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding PhaseText, Mode=OneWay}" />
                                    <Run Text="{Binding BytesText, Mode=OneWay}" Foreground="{DynamicResource Dn.TextTertiary}" />
                                </TextBlock>
                                <ProgressBar Style="{StaticResource Dn.Progress}" Margin="0,8,0,2" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Dn.Text.Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding Advice, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                            <c:StatusPill Grid.Column="2" Kind="{Binding StatusKind}" Glyph="{Binding StatusGlyph}" Text="{Binding PhaseText}" MaxWidth="240" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,60,0,0"
                    Visibility="{Binding Session.Items.Count, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}">
            <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE896;" FontSize="40" Foreground="{DynamicResource Dn.TextTertiary}" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Loc Progress.NoSession}" Style="{StaticResource Dn.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
