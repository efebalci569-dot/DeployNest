<UserControl x:Class="DeployNest.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:DeployNest.App.Localization"
             xmlns:c="clr-namespace:DeployNest.App.Controls"
             xmlns:vm="clr-namespace:DeployNest.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ResultsViewModel}">
    <UserControl.Resources>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Dn.DisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Dn.PageHeader}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subline}" Style="{StaticResource Dn.Text.Secondary}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Dn.InfoBar}" Margin="0,16,0,0" Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE777;" Foreground="{DynamicResource Dn.WarningText}" Margin="0,0,12,0" />
                    <TextBlock Text="{l:Loc Results.Reboot}" Style="{StaticResource Dn.Text.Body}" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="-6,16,-6,0">
                <Border Style="{StaticResource Dn.Card}" Margin="6" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Succeeded}" Style="{StaticResource StatNumber}" Foreground="{DynamicResource Dn.SuccessText}" />
                        <TextBlock Text="{l:Loc Results.Stat.Succeeded}" Style="{StaticResource Dn.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dn.Card}" Margin="6" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Failed}" Style="{StaticResource StatNumber}" Foreground="{DynamicResource Dn.DangerText}" />
                        <TextBlock Text="{l:Loc Results.Stat.Failed}" Style="{StaticResource Dn.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dn.Card}" Margin="6" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Skipped}" Style="{StaticResource StatNumber}" Foreground="{DynamicResource Dn.WarningText}" />
                        <TextBlock Text="{l:Loc Results.Stat.Skipped}" Style="{StaticResource Dn.Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dn.Card}" Margin="6" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Canceled}" Style="{StaticResource StatNumber}" Foreground="{DynamicResource Dn.TextSecondary}" />
                        <TextBlock Text="{l:Loc Results.Stat.Canceled}" Style="{StaticResource Dn.Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,14">
            <WrapPanel>
                <Button Style="{StaticResource Dn.Button}" Command="{Binding ExportReportCommand}" Margin="0,0,8,8"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Results.Export}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button}" Command="{Binding OpenReportCommand}" Margin="0,0,8,8"
                        Visibility="{Binding Session.LastReportPath, Converter={StaticResource HasValueToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Results.OpenReport}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Results.OpenLogs}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button}" Command="{Binding RetryFailedCommand}" Margin="0,0,8,8"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Results.Retry}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button.Primary}" Content="{l:Loc Results.Done}" Command="{Binding DoneCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Dn.Text.Caption}" Visibility="{Binding Session.LastReportPath, Converter={StaticResource HasValueToVisibility}}">
                <Run Text="{l:Loc Results.SavedTo}" /> <Run Text="{Binding Session.LastReportPath, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding Session.Items}" ItemContainerStyle="{StaticResource Dn.PlainItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,24" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProgressItemViewModel}">
                    <Border Style="{StaticResource Dn.Card}" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:AppIcon Width="36" Monogram="{Binding Software.Monogram}" AccentColor="{Binding Software.AccentColor}" Source="{Binding Software.Icon}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                <TextBlock Style="{StaticResource Dn.Text.BodyStrong}">
                                    <Run Text="{Binding Software.Name, Mode=OneWay}" />
                                    <Run Text="{Binding DurationText, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource Dn.TextTertiary}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{Binding MethodText}" Style="{StaticResource Dn.Text.Caption}" />
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Dn.Text.Body}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Dn.Text.Caption}" Margin="0,2,0,0" Visibility="{Binding Advice, Converter={StaticResource HasValueToVisibility}}">
                                    <Run Text="{l:Loc Results.Advice}" FontWeight="SemiBold" /> <Run Text="{Binding Advice, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Dn.Text.Caption}" Foreground="{DynamicResource Dn.TextTertiary}" Margin="0,2,0,0"
                                           Visibility="{Binding Notes, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                            <c:StatusPill Grid.Column="2" Kind="{Binding StatusKind}" Glyph="{Binding StatusGlyph}" Text="{Binding PhaseText}" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
