<UserControl x:Class="DeployNest.App.Views.ProgramDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:DeployNest.App.Localization"
             xmlns:c="clr-namespace:DeployNest.App.Controls"
             xmlns:vm="clr-namespace:DeployNest.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ProgramDetailsViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type vm:InfoRow}">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Dn.Text.Secondary}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Dn.Text.Body}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,120" MaxWidth="1080" HorizontalAlignment="Stretch">
            <Button Style="{StaticResource Dn.Button.Subtle}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-8,0,0,12" AutomationProperties.Name="{l:Loc Common.Back}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE72B;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{l:Loc Common.Back}" />
                </StackPanel>
            </Button>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:AppIcon Width="72" Monogram="{Binding Item.Monogram}" AccentColor="{Binding Item.AccentColor}" Source="{Binding Item.Icon}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.Name}" Style="{StaticResource Dn.PageHeader}" />
                    <TextBlock Text="{Binding Item.Publisher}" Style="{StaticResource Dn.Text.Secondary}" />
                    <WrapPanel Margin="0,10,0,0">
                        <c:StatusPill Kind="{Binding Item.StateKind}" Text="{Binding Item.StateText}" Glyph="{Binding Item.StateGlyph}" Margin="0,0,8,0" />
                        <c:StatusPill Kind="Neutral" Text="{Binding Item.CategoryName}" Margin="0,0,8,0" />
                        <c:StatusPill Kind="Accent" Glyph="&#xE73E;" Text="{l:Loc Details.InSelection}" Visibility="{Binding Item.IsSelected, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Dn.Button}" Command="{Binding ToggleSelectionCommand}" Margin="0,0,8,0"
                            Visibility="{Binding Item.IsSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" AutomationProperties.Name="{l:Loc Details.Select}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Loc Details.Select}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Dn.Button}" Command="{Binding ToggleSelectionCommand}" Margin="0,0,8,0"
                            Visibility="{Binding Item.IsSelected, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{l:Loc Details.Unselect}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE738;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Loc Details.Unselect}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Dn.Button.Primary}" Command="{Binding InstallNowCommand}" AutomationProperties.Name="{l:Loc Details.InstallNow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Loc Details.InstallNow}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Dn.InfoBar}" Margin="0,20,0,0" Visibility="{Binding Item.Notes, Converter={StaticResource HasValueToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE946;" Foreground="{DynamicResource Dn.WarningText}" Margin="0,2,12,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Item.Notes}" Style="{StaticResource Dn.Text.Body}" MaxWidth="900" />
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Dn.Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Details.About}" Style="{StaticResource Dn.Text.Subtitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Dn.Text.Body}" LineHeight="22" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource Dn.Button.Link}" Command="{Binding OpenHomepageCommand}" Margin="-6,0,12,0"
                                        Visibility="{Binding Item.Homepage, Converter={StaticResource HasValueToVisibility}}" AutomationProperties.Name="{l:Loc Details.Homepage}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:Loc Details.Homepage}" />
                                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE8A7;" FontSize="11" Margin="6,1,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Dn.Button.Link}" Command="{Binding OpenLicenseCommand}"
                                        Visibility="{Binding Item.LicenseUrl, Converter={StaticResource HasValueToVisibility}}" AutomationProperties.Name="{l:Loc Details.LicenseTerms}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:Loc Details.LicenseTerms}" />
                                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE8A7;" FontSize="11" Margin="6,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Dn.Card}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Details.Detection}" Style="{StaticResource Dn.Text.Subtitle}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Item.Evidence}" Style="{StaticResource Dn.Text.Body}" />
                            <TextBlock Text="{l:Loc Details.Detection.Hint}" Style="{StaticResource Dn.Text.Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Dn.Card}" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Details.Info}" Style="{StaticResource Dn.Text.Subtitle}" Margin="0,6,0,6" />
                            <ItemsControl ItemsSource="{Binding InfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Dn.Card}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Details.Verify.Title}" Style="{StaticResource Dn.Text.Subtitle}" />
                            <TextBlock Text="{l:Loc Details.Verify.Hint}" Style="{StaticResource Dn.Text.Caption}" Margin="0,6,0,14" />
                            <Button Style="{StaticResource Dn.Button}" Command="{Binding VerifyCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{l:Loc Details.Verify.Button}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xEA18;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:Loc Details.Verify.Button}" />
                                </StackPanel>
                            </Button>
                            <ProgressBar Style="{StaticResource Dn.Progress}" IsIndeterminate="True" Margin="0,14,0,0"
                                         Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisibility}}" />
                            <c:StatusPill Kind="{Binding VerificationKind}" Text="{Binding VerificationText}" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                          Visibility="{Binding VerificationText, Converter={StaticResource HasValueToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding VerificationRows}" ItemTemplate="{StaticResource InfoRowTemplate}" Margin="0,8,0,0" Focusable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
