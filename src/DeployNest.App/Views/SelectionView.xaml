<UserControl x:Class="DeployNest.App.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:DeployNest.App.Localization"
             xmlns:c="clr-namespace:DeployNest.App.Controls"
             xmlns:vm="clr-namespace:DeployNest.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SelectionViewModel}">
    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{l:Loc Selection.Title}" Style="{StaticResource Dn.PageHeader}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dn.Text.Caption}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding State.SelectedCount, Converter={StaticResource HasValueToVisibility}}">
                <Button Style="{StaticResource Dn.Button.Subtle}" Command="{Binding ClearAllCommand}" Margin="0,0,8,0" AutomationProperties.Name="{l:Loc Selection.ClearAll}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Selection.ClearAll}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Dn.Button}" Content="{l:Loc Selection.AddMore}" Command="{Binding BrowseCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Dn.Button.Primary}" Command="{Binding StartInstallCommand}" AutomationProperties.Name="{l:Loc Common.StartInstall}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Common.StartInstall}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Dn.InfoBar}" Margin="0,0,0,12" Visibility="{Binding InstalledWarning, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Dn.WarningText}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding InstalledWarning}" Style="{StaticResource Dn.Text.Body}" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding State.Selected}" ItemContainerStyle="{StaticResource Dn.PlainItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,40">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SoftwareItemViewModel}">
                    <Border Style="{StaticResource Dn.Card}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:AppIcon Width="36" Monogram="{Binding Monogram}" AccentColor="{Binding AccentColor}" Source="{Binding Icon}" />
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Dn.Text.BodyStrong}" />
                                <TextBlock Style="{StaticResource Dn.Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding Publisher, Mode=OneWay}" /> · <Run Text="{Binding SourceText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <c:StatusPill Grid.Column="2" Kind="{Binding StateKind}" Text="{Binding StateText}" Glyph="{Binding StateGlyph}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Dn.Text.Caption}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Style="{StaticResource Dn.Button.Icon}" Content="&#xE946;" ToolTip="{l:Loc Selection.Details}" AutomationProperties.Name="{l:Loc Selection.Details}"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Dn.Button.Icon}" Content="&#xE711;" ToolTip="{l:Loc Selection.Remove}" AutomationProperties.Name="{l:Loc Selection.Remove}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,70,0,0"
                    Visibility="{Binding State.SelectedCount, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}">
            <TextBlock Style="{StaticResource Dn.Icon}" Text="&#xE762;" FontSize="40" Foreground="{DynamicResource Dn.TextTertiary}" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Loc Selection.Empty.Title}" Style="{StaticResource Dn.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock Text="{l:Loc Selection.Empty.Body}" Style="{StaticResource Dn.Text.Secondary}" TextAlignment="Center" MaxWidth="440" />
            <Button Style="{StaticResource Dn.Button.Primary}" Content="{l:Loc Home.BrowseAll}" Command="{Binding BrowseCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
